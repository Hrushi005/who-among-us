<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vote Now - Who Among Us</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(180deg, #0f172a 0%, #1e293b 36%, #f0f5ff 36%, #f0f5ff 100%);
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-x: hidden;
        }

        /* Top Dark Bar with Question Counter */
        .top-bar {
            width: 100%;
            max-width: 920px;
            padding: 26px 24px 16px 24px;
            box-sizing: border-box;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #e2e8f0;
        }

        .q-counter {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 900;
            color: #f8fafc;
        }

        .q-badge-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f59e0b, #ef4444);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 900;
            color: white;
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
            transition: transform 0.3s ease;
        }

        .player-pill {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 7px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 800;
            color: #f1f5f9;
        }

        /* Smooth Progress Bar */
        .progress-track {
            width: 92%;
            max-width: 920px;
            height: 7px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            margin-bottom: 18px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            width: <%= (1 / questions.length) * 100 %>%;
            background: linear-gradient(90deg, #f59e0b, #10b981, #6366f1);
            border-radius: 10px;
            transition: width 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        /* Main White Voting Card */
        .voting-card {
            background: #ffffff;
            width: 92%;
            max-width: 920px;
            border-radius: 32px;
            padding: 50px 40px 48px 40px;
            box-sizing: border-box;
            box-shadow: 0 25px 60px rgba(15, 23, 42, 0.14);
            text-align: center;
            margin-bottom: 50px;
            position: relative;
            overflow: hidden;
        }

        /* Question Transition Wrapper */
        .stage-content {
            transition: all 0.32s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .stage-content.slide-out-left {
            opacity: 0;
            transform: translateX(-55px) scale(0.96);
        }

        .stage-content.slide-in-right {
            animation: slideInBounce 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        @keyframes slideInBounce {
            0% {
                opacity: 0;
                transform: translateX(55px) scale(0.96);
            }
            100% {
                opacity: 1;
                transform: translateX(0) scale(1);
            }
        }

        /* Question Text */
        .question-title {
            font-size: 32px;
            font-weight: 900;
            color: #0f172a;
            margin: 0 auto 44px auto;
            max-width: 680px;
            line-height: 1.25;
        }

        /* Friends Character Grid */
        .friends-grid {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 30px;
            margin-bottom: 45px;
        }

        .friend-option {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            width: 125px;
            user-select: none;
            transition: transform 0.25s ease;
            animation: popCard 0.4s backwards;
        }

        @keyframes popCard {
            0% { opacity: 0; transform: translateY(18px) scale(0.85); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }

        .friend-option:hover {
            transform: translateY(-7px);
        }

        /* Character Circle & Floating Number Badge */
        .char-avatar-box {
            position: relative;
            width: 108px;
            height: 108px;
            border-radius: 50%;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 14px;
            transition: all 0.25s ease;
            border: 3px solid #f1f5f9;
        }

        .friend-option.selected .char-avatar-box {
            background: linear-gradient(135deg, #fef3c7 0%, #d1fae5 100%);
            border-color: #f59e0b;
            box-shadow: 0 14px 28px rgba(245, 158, 11, 0.28);
            transform: scale(1.08);
        }

        .char-img {
            width: 82px;
            height: auto;
            filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.14));
            transition: transform 0.25s ease;
        }

        .friend-option.selected .char-img {
            animation: bounceSelect 0.55s ease;
        }

        @keyframes bounceSelect {
            0%, 100% { transform: scale(1) rotate(0deg); }
            40% { transform: scale(1.2) rotate(-6deg); }
            75% { transform: scale(1.12) rotate(5deg); }
        }

        /* Small Number Badge near Visor */
        .char-num-badge {
            position: absolute;
            top: 18px;
            right: 2px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            color: white;
            font-size: 12px;
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
            box-shadow: 0 3px 8px rgba(0,0,0,0.2);
        }

        .friend-name {
            font-size: 16.5px;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 12px;
            word-break: break-word;
            transition: 0.2s;
        }

        .friend-option.selected .friend-name {
            color: #d97706;
            font-weight: 900;
            transform: scale(1.05);
        }

        /* Custom Radio Circle under Name */
        .radio-circle {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 2.5px solid #cbd5e1;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .friend-option:hover .radio-circle {
            border-color: #f59e0b;
        }

        .radio-dot {
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f59e0b, #ef4444);
            transform: scale(0);
            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .friend-option.selected .radio-circle {
            border-color: #f59e0b;
            background: #fef3c7;
            box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.16);
        }

        .friend-option.selected .radio-dot {
            transform: scale(1);
        }

        /* 🔥 Purana Animated Shimmer Button with Golden-Amber/Orange Vibe */
        .btn-submit-vote {
            position: relative;
            width: 100%;
            max-width: 440px;
            padding: 19px 36px;
            border-radius: 50px;
            border: none;
            font-family: 'Nunito', sans-serif;
            font-size: 20px;
            font-weight: 900;
            color: white;
            background: linear-gradient(135deg, #f59e0b 0%, #ea580c 50%, #dc2626 100%);
            background-size: 200% auto;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            overflow: hidden;
            box-shadow: 0 12px 30px rgba(245, 158, 11, 0.45), inset 0 -3px 0 rgba(0,0,0,0.18);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            animation: pulseVoteBtn 2.2s infinite;
        }

        /* Shimmer Light Sweep Inside Button */
        .btn-submit-vote::before {
            content: "";
            position: absolute;
            top: 0;
            left: -100%;
            width: 60%;
            height: 100%;
            background: linear-gradient(
                120deg,
                transparent,
                rgba(255, 255, 255, 0.38),
                transparent
            );
            animation: shimmerSweep 3s infinite;
        }

        @keyframes shimmerSweep {
            0% { left: -100%; }
            55%, 100% { left: 140%; }
        }

        .btn-submit-vote .btn-icon {
            font-size: 21px;
            transition: transform 0.3s ease;
        }

        .btn-submit-vote:hover {
            background-position: right center;
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 18px 36px rgba(234, 88, 12, 0.55), inset 0 -3px 0 rgba(0,0,0,0.2);
        }

        .btn-submit-vote:hover .btn-icon {
            transform: translateX(6px) rotate(8deg) scale(1.15);
        }

        .btn-submit-vote:active {
            transform: translateY(1px) scale(0.98);
        }

        .btn-submit-vote.ready-pop {
            background: linear-gradient(135deg, #10b981 0%, #f59e0b 50%, #ef4444 100%);
            background-size: 200% auto;
            transform: scale(1.04);
        }

        @keyframes pulseVoteBtn {
            0% { box-shadow: 0 12px 30px rgba(245, 158, 11, 0.45), 0 0 0 0 rgba(239, 68, 68, 0.5); }
            70% { box-shadow: 0 12px 30px rgba(245, 158, 11, 0.45), 0 0 0 16px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 12px 30px rgba(245, 158, 11, 0.45), 0 0 0 0 rgba(239, 68, 68, 0); }
        }

        @keyframes shakeError {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            50% { transform: translateX(8px); }
            75% { transform: translateX(-6px); }
        }

        .shake {
            animation: shakeError 0.35s ease;
        }

        @media (max-width: 650px) {
            .voting-card {
                padding: 35px 18px;
                border-radius: 24px;
            }
            .question-title {
                font-size: 23px;
                margin-bottom: 30px;
            }
            .friends-grid {
                gap: 16px;
            }
            .friend-option {
                width: 96px;
            }
            .char-avatar-box {
                width: 86px;
                height: 86px;
            }
            .char-img {
                width: 66px;
            }
        }
    </style>
</head>
<body>

    <!-- Top Dark Header -->
    <div class="top-bar">
        <div class="q-counter">
            <div class="q-badge-icon" id="qIconNum">1</div>
            <span id="qCounterText">Question 1 / <%= questions.length %></span>
        </div>
        <div class="player-pill">👋 Voting as: <strong><%= player %></strong></div>
    </div>

    <!-- Animated Progress Bar -->
    <div class="progress-track">
        <div class="progress-fill" id="progressBar"></div>
    </div>

    <!-- Main White Voting Card -->
    <div class="voting-card">
        <div class="stage-content" id="stageContent">
            <h2 class="question-title" id="questionTitle"><%= questions[0] %></h2>

            <!-- Friends Characters Selection Row -->
            <div class="friends-grid" id="friendsGrid">
                <%
                    const colorBadgeMap = {
                        red: '#ef4444',
                        pink: '#ec4899',
                        green: '#10b981',
                        yellow: '#eab308',
                        black: '#334155',
                        purple: '#7c3aed',
                        orange: '#f97316',
                        blue: '#2563eb',
                        lite_blue: '#06b6d4'
                    };
                %>
                <% friendsWithAvatars.forEach((fObj, idx) => {
                    const bColor = colorBadgeMap[fObj.avatar] || '#f59e0b';
                %>
                    <div class="friend-option" style="animation-delay: <%= idx * 0.05 %>s;" onclick="selectFriend(this, '<%= fObj.name %>')">
                        <div class="char-avatar-box">
                            <img src="/images/<%= fObj.avatar %>.png" class="char-img" alt="<%= fObj.name %>">
                            <div class="char-num-badge" style="background: <%= bColor %>;"><%= idx + 1 %></div>
                        </div>
                        <div class="friend-name"><%= fObj.name %></div>
                        <div class="radio-circle">
                            <div class="radio-dot"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- Hidden Form to Submit All Votes at the End -->
        <form id="finalVotesForm" action="/submit-votes" method="POST">
            <input type="hidden" name="roomCode" value="<%= roomCode %>">
            <input type="hidden" name="voterName" value="<%= player %>">
            <input type="hidden" name="answersJson" id="answersJsonInput">

            <button type="button" class="btn-submit-vote" id="submitVoteBtn" onclick="nextQuestion()">
                <span id="btnText">Lock In Vote</span>
                <span class="btn-icon" id="btnIcon">⚡</span>
            </button>
        </form>
    </div>

    <script>
        const questions = <%- JSON.stringify(questions) %>;
        let currentQIndex = 0;
        let selectedFriendForCurrentQ = null;
        let isAnimating = false;
        const collectedAnswers = {};

        const stageContent = document.getElementById('stageContent');
        const qCounterText = document.getElementById('qCounterText');
        const qIconNum = document.getElementById('qIconNum');
        const progressBar = document.getElementById('progressBar');
        const questionTitle = document.getElementById('questionTitle');
        const friendOptions = document.querySelectorAll('.friend-option');
        const submitVoteBtn = document.getElementById('submitVoteBtn');
        const btnText = document.getElementById('btnText');
        const btnIcon = document.getElementById('btnIcon');

        function selectFriend(element, friendName) {
            if (isAnimating) return;
            friendOptions.forEach(opt => opt.classList.remove('selected'));
            element.classList.add('selected');
            selectedFriendForCurrentQ = friendName;

            submitVoteBtn.classList.add('ready-pop');
            btnText.innerText = currentQIndex === questions.length - 1
                ? `Expose ${friendName} & Finish`
                : `Vote for ${friendName}`;
            btnIcon.innerText = "🚀";
        }

        function nextQuestion() {
            if (isAnimating) return;

            if (!selectedFriendForCurrentQ) {
                submitVoteBtn.classList.remove('shake');
                void submitVoteBtn.offsetWidth;
                submitVoteBtn.classList.add('shake');
                btnText.innerText = "Pick a Friend First!";
                btnIcon.innerText = "👆";
                return;
            }

            collectedAnswers[currentQIndex] = selectedFriendForCurrentQ;

            if (currentQIndex < questions.length - 1) {
                isAnimating = true;
                currentQIndex++;
                selectedFriendForCurrentQ = null;

                stageContent.classList.remove('slide-in-right');
                stageContent.classList.add('slide-out-left');

                setTimeout(() => {
                    friendOptions.forEach((opt, idx) => {
                        opt.classList.remove('selected');
                        opt.style.animation = 'none';
                        void opt.offsetWidth;
                        opt.style.animation = `popCard 0.4s backwards ${idx * 0.05}s`;
                    });

                    submitVoteBtn.classList.remove('ready-pop');

                    qIconNum.innerText = currentQIndex + 1;
                    qIconNum.style.transform = 'scale(1.25)';
                    setTimeout(() => qIconNum.style.transform = 'scale(1)', 200);

                    qCounterText.innerText = `Question ${currentQIndex + 1} / ${questions.length}`;
                    progressBar.style.width = `${((currentQIndex + 1) / questions.length) * 100}%`;
                    questionTitle.innerText = questions[currentQIndex];

                    if (currentQIndex === questions.length - 1) {
                        btnText.innerText = "Final Question Vote";
                        btnIcon.innerText = "🔥";
                    } else {
                        btnText.innerText = "Lock In Vote";
                        btnIcon.innerText = "⚡";
                    }

                    stageContent.classList.remove('slide-out-left');
                    stageContent.classList.add('slide-in-right');

                    setTimeout(() => {
                        isAnimating = false;
                    }, 380);
                }, 280);

            } else {
                btnText.innerText = "Calculating Expose...";
                btnIcon.innerText = "🎉";
                document.getElementById('answersJsonInput').value = JSON.stringify(collectedAnswers);
                document.getElementById('finalVotesForm').submit();
            }
        }
    </script>
</body>
</html>