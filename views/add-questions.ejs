<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Questions - Who Among Us</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            font-family: 'Nunito', sans-serif;
            background-color: #f4f7fb;
            color: #2d3748;
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* Pastel Background Blobs (Warm Yellow & Soft Blue) */
        .bg-blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            opacity: 0.65;
            animation: moveBlob 10s infinite ease-in-out alternate;
        }
        .blob1 { width: 420px; height: 420px; background: #fde68a; top: -80px; left: -80px; }
        .blob2 { width: 450px; height: 450px; background: #fed7aa; bottom: -100px; right: -60px; animation-delay: 2s; }

        @keyframes moveBlob {
            0% { transform: translateY(0px) scale(1); }
            100% { transform: translateY(-25px) scale(1.08); }
        }

        /* Navbar */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            z-index: 10;
        }

        .back-btn {
            text-decoration: none;
            color: #4a5568;
            font-weight: 800;
            font-size: 16px;
            transition: 0.3s;
        }
        .back-btn:hover { color: #d97706; transform: translateX(-3px); }

        .logo {
            font-size: 22px;
            font-weight: 900;
            color: #1a202c;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-right { font-size: 20px; cursor: pointer; }

        /* 4 Steps Tracker */
        .steps-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 24px;
            padding: 15px 10px;
            max-width: 800px;
            margin: 5px auto 25px auto;
            flex-wrap: wrap;
        }

        .step {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 800;
            font-size: 14px;
            color: #a0aec0;
        }

        .step.completed {
            color: #10b981;
        }

        .step.active {
            color: #d97706;
            border-bottom: 3px solid #f59e0b;
            padding-bottom: 5px;
        }

        .step-number {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            border: 2px solid #e2e8f0;
            background: white;
            color: #a0aec0;
        }

        .step.completed .step-number {
            background: #d1fae5;
            border-color: #10b981;
            color: #059669;
        }

        .step.active .step-number {
            background: #f59e0b;
            border-color: #f59e0b;
            color: white;
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
        }

        /* Main Card Layout */
        .main-content {
            flex-grow: 1;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 0 20px 60px 20px;
        }

        .card {
            background: white;
            padding: 40px 50px;
            border-radius: 28px;
            box-shadow: 0 25px 50px rgba(245, 158, 11, 0.1);
            width: 100%;
            max-width: 780px;
            position: relative;
            z-index: 5;
        }

        .card-body {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 40px;
        }

        .left-section {
            flex: 1;
        }

        h2 {
            font-size: 32px;
            font-weight: 900;
            color: #1a202c;
            margin: 0 0 6px 0;
        }

        p.subtitle {
            color: #718096;
            font-weight: 700;
            font-size: 15px;
            margin: 0 0 25px 0;
        }

        /* Questions List */
        .questions-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-height: 350px;
            overflow-y: auto;
            padding-right: 8px;
            margin-bottom: 15px;
        }

        .questions-list::-webkit-scrollbar {
            width: 6px;
        }
        .questions-list::-webkit-scrollbar-thumb {
            background: #fcd34d;
            border-radius: 10px;
        }

        .question-row {
            display: flex;
            align-items: center;
            gap: 12px;
            animation: fadeIn 0.25s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .question-num {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 2px solid #fde68a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 14px;
            color: #b45309;
            background: #fffbeb;
            flex-shrink: 0;
        }

        .question-input {
            flex: 1;
            padding: 13px 16px;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            font-size: 14.5px;
            font-family: 'Nunito', sans-serif;
            font-weight: 700;
            color: #1a202c;
            background: #f8fafc;
            transition: 0.25s;
        }

        .question-input:focus {
            outline: none;
            border-color: #f59e0b;
            background: white;
            box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.15);
        }

        .delete-btn {
            background: none;
            border: none;
            color: #a0aec0;
            font-size: 18px;
            cursor: pointer;
            padding: 6px;
            border-radius: 8px;
            transition: 0.2s;
        }

        .delete-btn:hover {
            color: #ef4444;
            background: #fee2e2;
        }

        /* Add Question Button */
        .add-more-btn {
            width: 100%;
            padding: 12px;
            border-radius: 12px;
            border: 2px dashed #f59e0b;
            background: #fffbeb;
            color: #b45309;
            font-family: 'Nunito', sans-serif;
            font-weight: 800;
            font-size: 15px;
            cursor: pointer;
            transition: 0.25s;
            margin-bottom: 10px;
        }

        .add-more-btn:hover {
            background: #fef3c7;
            transform: translateY(-2px);
        }

        .helper-text {
            font-size: 13px;
            color: #718096;
            font-weight: 700;
            margin: 0 0 20px 0;
        }

        /* Right Side Character */
        .right-section {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .character-graphic {
            width: 215px;
            animation: floatChar 3.5s infinite ease-in-out;
            filter: drop-shadow(0 12px 20px rgba(0,0,0,0.12));
        }

        @keyframes floatChar {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-14px) rotate(2deg); }
        }

        /* Footer Navigation Buttons */
        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 15px;
            padding-top: 20px;
            border-top: 1px solid #f1f5f9;
        }

        .btn-prev {
            padding: 14px 28px;
            border-radius: 14px;
            background: #f1f5f9;
            color: #475569;
            text-decoration: none;
            font-weight: 800;
            font-size: 16px;
            transition: 0.25s;
        }

        .btn-prev:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

        /* Animated Golden-Yellow Premium Button */
        .btn-next {
            padding: 16px 42px;
            border-radius: 16px;
            font-size: 18px;
            font-weight: 900;
            background: linear-gradient(135deg, #facc15 0%, #f59e0b 50%, #eab308 100%);
            background-size: 200% auto;
            color: #1a202c; /* Dark text for crisp readability on yellow */
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: 0.3s ease;
            box-shadow: 0 10px 25px rgba(245, 158, 11, 0.45);
            animation: pulseYellow 2.5s infinite;
        }

        .btn-next:hover {
            background-position: right center;
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 15px 30px rgba(245, 158, 11, 0.65);
        }

        @keyframes pulseYellow {
            0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.55); }
            70% { box-shadow: 0 0 0 16px rgba(245, 158, 11, 0); }
            100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
        }

        @media(max-width: 768px) {
            .card-body {
                flex-direction: column;
            }
            .character-graphic {
                width: 150px;
            }
            .card {
                padding: 30px 22px;
            }
        }
    </style>
</head>
<body>
    <div class="bg-blob blob1"></div>
    <div class="bg-blob blob2"></div>

    <!-- Top Navbar -->
    <div class="navbar">
        <a href="/add-friends/<%= roomCode %>" class="back-btn">← Back</a>
        <div class="logo">🕵️ Who Among Us</div>
        <div class="nav-right">🌙</div>
    </div>

    <!-- 4 Steps Tracker -->
    <div class="steps-container">
        <div class="step completed">
            <div class="step-number">✓</div>
            <span>Create Room</span>
        </div>
        <div class="step completed">
            <div class="step-number">✓</div>
            <span>Add Friends</span>
        </div>
        <div class="step active">
            <div class="step-number">3</div>
            <span>Add Questions</span>
        </div>
        <div class="step">
            <div class="step-number">4</div>
            <span>Share Link</span>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="main-content">
        <div class="card">
            <form action="/add-questions" method="POST" id="questionsForm">
                <input type="hidden" name="roomCode" value="<%= roomCode %>">

                <div class="card-body">
                    <div class="left-section">
                        <h2>Add Fun Questions</h2>
                        <p class="subtitle">We've loaded the best expose questions! Edit them or add your own.</p>

                        <div class="questions-list" id="questionsList">
                            <% defaultQuestions.forEach((q, index) => { %>
                                <div class="question-row">
                                    <div class="question-num"><%= index + 1 %></div>
                                    <input type="text" name="questions[]" class="question-input" value="<%= q %>" required>
                                    <button type="button" class="delete-btn" onclick="removeQuestion(this)" title="Remove">🗑️</button>
                                </div>
                            <% }) %>
                        </div>

                        <button type="button" class="add-more-btn" id="addBtn" onclick="addQuestion()">
                            + Add Custom Question
                        </button>
                        <p class="helper-text" id="counterText">You can add up to 12 questions (<%= defaultQuestions.length %>/12 added).</p>
                    </div>

                    <!-- Right Side Yellow Character Image -->
                    <div class="right-section">
                        <img src="/images/question.png" class="character-graphic" alt="Think & Vote Yellow Character">
                    </div>
                </div>

                <!-- Footer Buttons -->
                <div class="card-footer">
                    <a href="/add-friends/<%= roomCode %>" class="btn-prev">← Back</a>
                    <button type="submit" class="btn-next">Next →</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const maxQuestions = 12;
        const minQuestions = 3;
        const questionsList = document.getElementById('questionsList');
        const addBtn = document.getElementById('addBtn');
        const counterText = document.getElementById('counterText');

        function updateUI() {
            const rows = questionsList.querySelectorAll('.question-row');
            const count = rows.length;

            rows.forEach((row, index) => {
                row.querySelector('.question-num').innerText = index + 1;
            });

            counterText.innerText = `You can add up to 12 questions (${count}/12 added).`;

            if (count >= maxQuestions) {
                addBtn.style.display = 'none';
            } else {
                addBtn.style.display = 'block';
            }
        }

        function addQuestion() {
            const rows = questionsList.querySelectorAll('.question-row');
            if (rows.length >= maxQuestions) return;

            const newRow = document.createElement('div');
            newRow.className = 'question-row';
            newRow.innerHTML = `
                <div class="question-num">${rows.length + 1}</div>
                <input type="text" name="questions[]" class="question-input" placeholder="Type your wild question here..." required>
                <button type="button" class="delete-btn" onclick="removeQuestion(this)" title="Remove">🗑️</button>
            `;
            questionsList.appendChild(newRow);

            questionsList.scrollTop = questionsList.scrollHeight;
            newRow.querySelector('input').focus();
            updateUI();
        }

        function removeQuestion(btn) {
            const rows = questionsList.querySelectorAll('.question-row');
            if (rows.length <= minQuestions) {
                alert("Min 3 questions!");
                return;
            }
            btn.parentElement.remove();
            updateUI();
        }
    </script>
</body>
</html>